<Window x:Class="DeepSeekPet.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="偶鲸鲸对话" Width="250" Height="143" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="True" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
    </Window.Resources>
    <Border Margin="3" Padding="7,4" Background="#CFF3F6FA" BorderBrush="#8094A3B8"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="HeaderBar" MouseLeftButtonDown="HeaderDrag_Click" MouseMove="HeaderDrag_Move" MouseLeftButtonUp="HeaderDrag_End" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="×" Click="HideButton_Click" ToolTip="收起对话，计时继续"/>
                <Button DockPanel.Dock="Right" Content="⚙" Click="SettingsButton_Click" ToolTip="设置 API 与桌宠"/>
                <Button DockPanel.Dock="Right" Content="＋" Click="ClearChat_Click" ToolTip="新会话"/>
                <TextBlock x:Name="HeaderTitle" Text="偶鲸鲸" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
            </DockPanel>
            <Border x:Name="NoticeBorder" Grid.Row="1" Background="#DAFFF0BD" CornerRadius="5" Padding="4" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" FontSize="11" Foreground="#614517" TextWrapping="Wrap"/>
            </Border>
            <TextBox x:Name="ChatOutput" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                     FontSize="12" Foreground="#18283D" Padding="1"/>
            <TextBlock x:Name="ChatStatus" Grid.Row="3" FontSize="10" Foreground="#52647B"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Grid Grid.Row="4" Margin="0,3,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" MinHeight="25" MaxHeight="45" TextWrapping="Wrap" AcceptsReturn="True"
                         MaxLength="8000" VerticalScrollBarVisibility="Auto" KeyDown="ChatInput_KeyDown"
                         Background="#BFFFFFFF" BorderBrush="#7094A3B8" Padding="3" FontSize="12"
                         />
                <Button x:Name="ChatSend" Grid.Column="1" Content="↑" FontSize="17" Click="SendChat_Click" ToolTip="发送"/>
                <Button x:Name="ChatCancel" Grid.Column="1" Content="■" Click="CancelChat_Click" Visibility="Collapsed" ToolTip="停止回复"/>
                <Button x:Name="ExpandButton" Grid.Column="2" Content="⤢" FontSize="17" Click="Expand_Click" ToolTip="展开至桌宠全身范围"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="DeepSeekPet.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠小助手" Width="460" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#DDE8D5C1"/>
            <Setter Property="BorderBrush" Value="#FF98704E"/>
            <Setter Property="Foreground" Value="#FF4A3425"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#D9FFF8ED"/>
            <Setter Property="BorderBrush" Value="#FFAA8463"/>
            <Setter Property="Foreground" Value="#FF4A3425"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="15,6"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Fill">
    <Grid Width="460" Height="430">
        <Polygon x:Name="LeftTail" Points="18,0 18,30 0,15"
                 Fill="#EAF0DEC8" Stroke="#FF8D6748" StrokeThickness="1"
                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Polygon x:Name="RightTail" Points="0,0 0,30 18,15"
                 Fill="#EAF0DEC8" Stroke="#FF8D6748" StrokeThickness="1"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Visibility="Collapsed"/>

        <Border Margin="17,8" Background="#EAF0DEC8" BorderBrush="#FF8D6748"
                BorderThickness="1.5" CornerRadius="22" Padding="17">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Color="#FF5B3D27"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="2,0,2,9">
                    <Button DockPanel.Dock="Right" Content="×" FontSize="17" FontWeight="Bold"
                            Width="32" Height="28" Padding="0" Click="HideButton_Click"
                            ToolTip="收起气泡"/>
                    <StackPanel>
                        <TextBlock Text="小助手" FontSize="21" FontWeight="SemiBold" Foreground="#FF432E20"/>
                        <TextBlock x:Name="TypingText" Text=""
                                   Foreground="#FF76543C" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Border x:Name="NoticeBorder" Grid.Row="1" Background="#FFFFF4D8"
                        BorderBrush="#FFF0C56B" BorderThickness="1" CornerRadius="9"
                        Padding="10,7" Margin="2,0,2,8" Visibility="Collapsed">
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#FF6F4B13"/>
                </Border>

                <TabControl x:Name="AssistantTabs" Grid.Row="2" Background="#DDF8EEDF"
                            Foreground="#FF4A3425" BorderBrush="#FFB28D6C">
                    <TabItem Header="天气">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="查询" Click="RefreshWeather_Click"/>
                                <TextBox x:Name="CityBox" ToolTip="输入城市名，例如：上海"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="WeatherCityText" Text="输入城市后查询"
                                           FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="WeatherTemperatureText" Text="--°C"
                                           FontSize="43" FontWeight="Light" Foreground="#FF3478D4"
                                           HorizontalAlignment="Center" Margin="0,7,0,2"/>
                                <TextBlock x:Name="WeatherDetailText" Text="" TextWrapping="Wrap"
                                           FontSize="13" Foreground="#FF475467" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="数据来源：Open-Meteo"
                                       Foreground="#FF98A2B3" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="番茄钟">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="专注" VerticalAlignment="Center"/>
                                <TextBox x:Name="FocusMinutesBox" Width="43" TextAlignment="Center"/>
                                <TextBlock Text="分  休息" VerticalAlignment="Center"/>
                                <TextBox x:Name="BreakMinutesBox" Width="43" TextAlignment="Center"/>
                                <TextBlock Text="分" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TimerPhaseText" Text="准备专注" FontSize="15"
                                           Foreground="#FF667085" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TimerText" Text="25:00" FontFamily="Consolas"
                                           FontSize="52" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="StartPauseButton" Content="开始" Click="StartPause_Click" MinWidth="72"/>
                                <Button Content="重置" Click="ResetTimer_Click" MinWidth="72"/>
                                <Button Content="切换" Click="SwitchPhase_Click" MinWidth="72"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="待办">
                        <Grid Margin="13">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="添加" Click="AddTodo_Click"/>
                                <TextBox x:Name="TodoInput" KeyDown="TodoInput_KeyDown"
                                         ToolTip="输入待办，按 Enter 添加"/>
                            </DockPanel>
                            <ListBox x:Name="TodoList" Grid.Row="1" Margin="3,7" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsDone}"
                                                  FontSize="14" Padding="5" Checked="TodoChanged" Unchecked="TodoChanged"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="删除选中" Click="DeleteTodo_Click"/>
                                <Button Content="清除完成" Click="ClearCompleted_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>

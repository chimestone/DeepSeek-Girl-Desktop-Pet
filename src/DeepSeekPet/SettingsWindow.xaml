<Window x:Class="DeepSeekPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠设置"
        Width="560" Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SkinCardStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="116" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#F7F8FA" BorderBrush="#D9DDE5"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#7D9BFF" />
                                <Setter TargetName="Card" Property="Background" Value="#F1F4FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4263EB" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Background" Value="#EAF0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="角色" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <ListBox x:Name="SkinList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource SkinCardStyle}"
                 SelectedValuePath="Id" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="-3,0,-3,14">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Height="76" Background="White" CornerRadius="6" Padding="3">
                            <Image Source="{Binding ResourceUri}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="{Binding DisplayName}" TextAlignment="Center"
                                   Margin="0,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Separator Grid.Row="2" Margin="0,0,0,14" />

        <TextBlock Grid.Row="3" Text="行为" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <CheckBox x:Name="AutoWalkCheck" Grid.Row="4" Content="允许她偶尔自动散步" Margin="0,0,0,14" />

        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="散步速度" />
                <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="SpeedSlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderValueChanged" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,18">
            <DockPanel>
                <TextBlock Text="角色大小" />
                <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="SizeSlider" Minimum="150" Maximum="420" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SliderValueChanged" />
        </StackPanel>

        <Separator Grid.Row="7" Margin="0,0,0,15" />

        <StackPanel Grid.Row="8">
            <CheckBox x:Name="TopmostCheck" Content="始终置顶" Margin="0,0,0,12" />
            <CheckBox x:Name="EdgeSnapCheck" Content="拖放后吸附屏幕边缘" Margin="0,0,0,12" />
            <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动" />
        </StackPanel>

        <StackPanel Grid.Row="9" Margin="0,18,0,14">
            <TextBlock Text="大模型对话" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="模型名称"/>
            <TextBox x:Name="ApiModel" Padding="5" Margin="0,4,0,8"/>
            <TextBlock Text="API Key（留空保留已保存的 Key）"/>
            <PasswordBox x:Name="ApiKey" Padding="5" Margin="0,4,0,4"/>
            <CheckBox x:Name="RemoveApiKey" Content="移除已保存的 Key" Margin="0,4,0,4"/>
            <TextBlock x:Name="ApiStatus" Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="Key 由 Windows 当前用户加密保存。普通对话将问题与近期上下文提交至 DeepSeek；本地待办与计时不依赖 API。" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="保存" Width="88" IsDefault="True" Click="SaveClicked" />
        </StackPanel>
    </Grid></ScrollViewer>
</Window>

<Window x:Class="DeepSeekPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 娘设置"
        Width="390" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="行为" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <CheckBox x:Name="AutoWalkCheck" Grid.Row="1" Content="允许她偶尔自动散步" Margin="0,0,0,14" />

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="散步速度" />
                <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="SpeedSlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderValueChanged" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <DockPanel>
                <TextBlock Text="角色大小" />
                <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="SizeSlider" Minimum="150" Maximum="420" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SliderValueChanged" />
        </StackPanel>

        <Separator Grid.Row="4" Margin="0,0,0,15" />

        <StackPanel Grid.Row="5">
            <CheckBox x:Name="TopmostCheck" Content="始终置顶" Margin="0,0,0,12" />
            <CheckBox x:Name="EdgeSnapCheck" Content="拖放后吸附屏幕边缘" Margin="0,0,0,12" />
            <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动" />
        </StackPanel>

        <TextBlock Grid.Row="6" Margin="0,22,0,0" Foreground="#666" TextWrapping="Wrap"
                   Text="左键拖动她，单击会有 Q 弹回应；右键可随时打开此设置或退出。动画使用同一张角色原画连续变形，避免逐帧身份漂移。" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="保存" Width="88" IsDefault="True" Click="SaveClicked" />
        </StackPanel>
    </Grid>
</Window>

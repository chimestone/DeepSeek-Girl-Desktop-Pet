<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeepSeekPet</AssemblyName>
    <Version>1.3.1</Version>
    <RootNamespace>DeepSeekPet</RootNamespace>
    <ApplicationIcon>Assets\deepseek-girl.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Skins\*.png" />
    <Content Include="Assets\deepseek-girl.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Audio\friends-wine-bilibili.m4a"
             Condition="Exists('Assets\Audio\friends-wine-bilibili.m4a')"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
